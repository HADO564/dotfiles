configuration {
  modi:                 "drun,window";
  show-icons:           true;
  icon-theme:           "Papirus-Dark";
  drun-display-format:  "{name}";
  window-format:        "{w}  {c}  {t}";
  disable-history:      false;
  hide-scrollbar:       true;
  sidebar-mode:         false;
  terminal:             "kitty";
  display-drun:         " Apps";
  display-window:       " Windows";
}

@theme "/home/hadoki/.config/rofi/theme.rasi"
