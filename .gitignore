config/qt6ct/colors/pywal.conf
config/qt5ct/qss/pywal.qss
config/qt6ct/qss/pywal.qss
config/hypr/colors.conf
config/hypr/wal-colors.conf
config/rofi/theme.rasi
config/cava/config

# Machine-specific
config/hypr/monitors.conf

# Editor / plugin state
config/nvim/lazy-lock.json
**/__pycache__/
*.pyc

# Scratch files
*.bak
*.bak-*
*.save
*.orig
*.log
*.qslog
