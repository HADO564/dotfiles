# Install with: brew bundle --file macos/Brewfile
# Best tool for the job — native macOS where it's good enough, third-party where it's better.

# --- shell ---
brew "starship"
brew "fzf"
brew "zoxide"
brew "eza"
brew "zsh-autosuggestions"
brew "zsh-syntax-highlighting"
brew "zsh-completions"

# --- dev ---
brew "gh"
brew "tmux"
brew "neovim"
brew "ripgrep"          # LazyVim live grep
brew "fd"               # LazyVim file finder
brew "tree-sitter-cli"  # nvim-treesitter builds parsers with it
brew "lazygit"          # `lg`, LazyVim <leader>gg
brew "direnv"           # per-project .envrc
brew "glow"             # markdown in the terminal

# --- terminal & fonts ---
cask "wezterm"
